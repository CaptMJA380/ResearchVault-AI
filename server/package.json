{
  "name": "researchvault-server",
  "version": "0.1.0",
  "type": "module",
  "description": "ResearchVault AI - Express API server",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "check:models": "node scripts/check-models.js",
    "check:db": "node scripts/check-db.js",
    "test:unit": "node tests/backend-unit.test.js",
    "test:api": "NODE_ENV=test node tests/api.test.js",
    "test": "node scripts/check-models.js && node tests/backend-unit.test.js && NODE_ENV=test node tests/api.test.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "supertest": "^7.3.1"
  }
}
